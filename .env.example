# ============================================
# LAAP 环境变量配置
# ============================================
# 复制此文件并填入你的配置:
#   cp .env.example .env
#
# 共三档模式，按需配置:
#   [MIN]  = 仅填必填项，其余模块用 fallback
#   [STD]  = 标准体验，推荐
#   [FULL] = 全功能，所有模块启
# ============================================

# 自选股列表（逗号分隔，支持沪深两市代码）
# 沪市：600xxx, 601xxx, 603xxx
# 深市：000xxx, 002xxx, 300xxx
STOCK_LIST=600519,300750,002594,000001,600144,600960,600511.SH,600133.SH,600114.SH,000523.SZ,600038.SH,000410.SZ

# Anspire Open API Keys（支持多个，逗号分隔）
# 获取: https://open.anspire.cn/?share_code=QFBC0FYC
# 在未配置更高优先级 OpenAI-compatible 来源时，满足条件可复用该 key 给 Anspire 大模型网关与新闻搜索。
# 下列网关与模型为当前项目示例配置；是否可用请以 Anspire 控制台与官方文档为准：
# 示例网关： https://open-gateway.anspire.cn/v6
# 示例模型：Doubao-Seed-2.0-lite（可覆盖为 ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-pro）
# 若网关有区域/版本差异，可覆盖为 ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.ai/v6
ANSPIRE_API_KEYS=
# ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
# ANSPIRE_LLM_ENABLED=true
# 数据源配置
# Tushare Pro Token（可选，从 https://tushare.pro/weborder/#/login?reg=834638 获取）
TUSHARE_TOKEN=
# TUSHARE_BASE_URL=https://api.tushare.pro
# Tushare 新闻快讯（NEWS_SOURCES 的 tushare 源，需 TUSHARE_TOKEN + news API 单独权限）
# TUSHARE_NEWS_SRC=cls
# TUSHARE_NEWS_LOOKBACK_HOURS=24
# TickFlow API Key（可选；用于 A 股日 K、实时行情、股票列表/名称与大盘复盘增强，权限不足自动回退）
# TICKFLOW_API_KEY=
# TICKFLOW_KLINE_ADJUST=none          # none/forward/backward/forward_additive/backward_additive
# TICKFLOW_BATCH_DAILY_ENABLED=true   # 有权限时通过 TickFlow 批量预取日 K
# TICKFLOW_BATCH_SIZE=100             # TickFlow 单次批量请求的最大标的数

# ── [MIN] 必填: LLM API 密钥 ─────────────────────────
# LAAP 的 PSI Core 依赖 LLM 进行需求调节和内容生成。
# 没有这个，认知循环会退化。
# 支持 DeepSeek / OpenAI / Anthropic 兼容 API。
DEEPSEEK_API_KEY=

# ── [STD] 可选: LLM 端点配置 ──────────────────────────
# 默认使用 DeepSeek，可切换为任意 OpenAI 兼容 API。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── [STD] 可选: 飞书集成 ──────────────────────────────
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_CHAT_ID=

# ── [STD] 可选: 端口配置 ──────────────────────────────
# 所有端口均有默认值，仅冲突时需修改。
LAAP_PORT=11546
LAAP_API_BASE=http://localhost:11546
# QUANTUM_PORT=11520
# PSI_ARIS_PORT=11551

# ── [STD] 可选: API 安全 ───────────────────────────────
# LAAP_API_KEY=            # 设置后所有 /v1/* 端点需携带 Authorization: Bearer <key>
# LAAP_HOST=127.0.0.1      # 绑定地址 (默认仅本机可达; 需局域网/公网访问时设 0.0.0.0, 强烈建议同时设置 LAAP_API_KEY)

# ── [FULL] 可选: 路径配置 ────────────────────────────
# Docker 部署下不需要修改——镜像内路径是固定的。
# 裸机部署时如果自动检测失败才需要显式指定。
# LAAP_ROOT=
# ARIS_BRAIN_ROOT=
# LAAP_STATE_DIR=
# HERMES_ROOT=

# ── 量化闭环: 纸面交易数据库（PG16 优先，SQLite 回退）─────
# DATABASE_URL 优先（SQLAlchemy/asyncpg 风格，自动解析 host/port/user/pass/db）
DATABASE_URL=postgresql+asyncpg://fileclaw:fileclaw_secret@192.168.88.251:54322/laap_trading
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# K线库（watchlist_kline_store，PG16）—— 独立于主库 laap_trading
KLINE_DB_BACKEND=postgres
KLINE_DB_URL=postgresql+asyncpg://fileclaw:fileclaw_secret@192.168.88.251:54322/watchlist_kline_store
# kline本地库回退地址 
WATCHLIST_KLINE_DB_PATH=/data/watchlist_kline/watchlist_kline_store.db
# 存储后端: postgres（默认，连 NAS fileclaw-postgres-vector PG16）| sqlite
PAPER_TRADING_DB_BACKEND=postgres
# SQLite 回退路径（PG 不可用时，laap_trading.db 含历史数据）
# 留空 = 自动解析 <项目根>/data/laap_trading.db（跨平台安全）。
# 不要填 Windows 盘符绝对路径（如 D:/laap-AGI/...）：非 Windows 平台会把它当
# 相对路径，在项目根下 mkdir 出 D: / D:\laap-AGI 垃圾目录。
PAPER_TRADING_DB_PATH=
# 每日量化管线调度器（真实 paper 成交序列收集）: 1=开启（值必须为 1，勿用 true/yes）
LAAP_QUANT_DAILY=1
LAAP_QUANT_DAILY_INTERVAL=86400
# M4 True RSI 受限递归引擎: 1=开启
LAAP_TRSI_ENABLED=1
# M2 代码进化调度器: 1=开启
LAAP_EVO_ENABLED=1
LAAP_EVO_INTERVAL=3600
# 新闻盘中轮询（新闻驱动自动下单）: 1=开启（判定质量稳定后再开）
LAAP_NEWS_INTRADAY=1
LAAP_NEWS_INTERVAL=3600
# 盘中轮询标的（LAAP_NEWS_SYMBOLS 优先；未设则取 STOCK_LIST 自选股；都未设用默认 600519,000001,000858）
LAAP_NEWS_SYMBOLS=
# 事件驱动层（EventBus + MarketEventSource + 场景订阅 + 调度线程）: 1=开启（默认关）
# 开启后: 盘中按 LAAP_POS_MONITOR_INTERVAL 节流触发持仓止盈/止损/移动止损;
#         收盘后 LAAP_DAILY_CYCLE_TIME 每日一次触发日级闭环（此时 QuantDailyScheduler
#         自动让位不另跑线程，避免双驱动重复跑日线）
LAAP_EVENT_DRIVEN=0
# 行情轮询间隔（秒，默认 5；tick 场景可调 1）
MARKET_EVENT_INTERVAL=5
# 盘中止损触发节流（秒，默认 30）
LAAP_POS_MONITOR_INTERVAL=30
# 日级闭环触发时刻（收盘后，默认 15:35）
LAAP_DAILY_CYCLE_TIME=15:35
# 调度线程基础节流 / 系统状态上报间隔（秒，默认 5 / 60）
LAAP_SCHEDULE_INTERVAL=5
LAAP_STATUS_INTERVAL=60
# 错误巡检（EventOrchestrator 调度线程周期跑 发现→分析→处理→总结 闭环）:
#   间隔秒（默认 300）；推送通道（空=仅事件+留痕不推送；qq/weixin/feishu 才推前端）
LAAP_ERROR_SCAN_INTERVAL=300
LAAP_ERROR_PUSH=
LAAP_ERROR_PUSH_TARGET=
LAAP_ERROR_REPORT_NORMAL=0
# 实时 tick 阈值告警（TickMonitor, 2026-08-18）:
#   LAAP_TICK_ALERT_PCT=5.0         单 tick 涨跌幅阈值（%），|chg| 超阈值触发告警
#   LAAP_TICK_ALERT_COOLDOWN=60.0   同标的告警冷却（秒），去抖防每 tick 刷屏
#   LAAP_TICK_ALERT_ALL_SESSION=0  1=任意时段告警；0=仅盘中+集合竞价窗口（去盘前/深夜噪音）
LAAP_TICK_ALERT_PCT=5.0
LAAP_TICK_ALERT_COOLDOWN=60.0
LAAP_TICK_ALERT_ALL_SESSION=0
# WebSocket 实时事件推送端点: GET /v1/quant/events/ws（EventBus → ws:// 桥接, 2026-08-18）
# 事件源依赖 LAAP_EVENT_DRIVEN=1；未启用时连接可建但无事件。客户端协议见
# docs/event-driven-layer-review-20260817.md 或 laap/paper_trading/ws_bridge.py。
# Aris 交易接入执行边界 (Phase 2): 1=允许 Aris 自动下单, 0/不设=只建议不下单 (fail-closed 默认)
# 二次确认词仍为硬门槛: 即使置 1, pt_execute/pt_close 也需用户明确确认。
PAPER_TRADING_AUTO_EXECUTE=0

# ── 量化可调参数（quant_config.py 单源，运行时可调；不设则用默认值）──
# 新闻判定门槛
NEWS_MIN_CONFIDENCE=0.7
# 风控红线（B1：R1-R5）
MAX_STOP_LOSS_PCT=0.05
MAX_POS_PER_STOCK=0.10
MAX_TOTAL_POS=0.50
MAX_DAILY_LOSS_PCT=0.02
CONSECUTIVE_LOSS_LIMIT=3
# 缓存 / 研报 / 股数
NEWS_CACHE_TTL=1800
RESEARCH_SL_MULT=2.0
RESEARCH_TP_MULT=3.0
ORDER_QTY_MODE=cash_pct
# 交易成本（默认对齐 costs.DEFAULT_COSTS 单源，env 可覆盖）
FEE_COMMISSION_RATE=0.00025
FEE_MIN_COMMISSION=0.0
FEE_STAMP_DUTY=0.0005
FEE_TRANSFER_FEE=0.0
FEE_SLIPPAGE=0.001


# ── 数据源多源配置（逗号分隔，按序尝试+回退；运行时可调）──
# 格式：`域`_SOURCES = 源1,源2,...；首位=主源，后续=回退；未实现源被 data_sources 跳过
# 行情：akshare 实时 → 腾讯快照 → 雪球快照 → stub 合成兜底
MARKET_SOURCES=tx,em,tickplus,xq,akshare,stub
# K线：kline.db 真实 → tushare(TUSHARE_TOKEN) → akshare 直连(stock_zh_a_hist) → 合成兜底
KLINE_SOURCES=db,tushare,akshare,synthetic
# 新闻：东财(stock_news_em) 已实现；sina/cls 已接入；tushare 为新闻快讯（需单独权限）
NEWS_SOURCES=eastmoney,sina,cls,tushare
# 资料：东财个股 → 东财F10(em_profile) → 巨潮概况 已实现
PROFILE_SOURCES=individual_info,em_profile,cninfo
# 研报：东财(stock_research_report_em) 已实现；cls/sina 已接入（CLS_REPORT_URL/SINA_REPORT_URL）
REPORT_SOURCES=eastmoney,cls,sina
# 交易日历：外部(akshare) → 本地缓存 → 工作日判断（已三级实现）
CALENDAR_SOURCES=external,cache,weekday
# LLM：openai SDK → urllib 直连 已实现；ollama/local 为未来候选
LLM_SOURCES=openai,urllib,ollama,local,cli

# ── 数据源供应商 API / base_addr（可配置，支持 {num}/{code}/{symbol} 占位符）──
# 新浪滚动新闻（{num}=条数）
SINA_NEWS_URL=https://feed.mix.sina.com.cn/api/roll/get?pageid=153&lid=2516&num={num}&page=1
# 财联社电报
CLS_NEWS_URL=https://www.cls.cn/nodeapi/updateTelegraphList?app=CailianpressWeb&category=&rn=20&os=web&sv=7.7.5
# 东财 F10 公司概况（{code}=SH600519/SZ000001）
EM_PROFILE_URL=https://emweb.securities.eastmoney.com/PC_HSF10/CompanySurvey/PageAjax?code={code}
# 新浪研报（{symbol}=600519）
SINA_REPORT_URL=https://vip.stock.finance.sina.com.cn/corp/go.php/vCB_AllStockReport/stockid/{symbol}.phtml
# 财联社研报
CLS_REPORT_URL=https://www.cls.cn/nodeapi/telegraphList?app=CailianpressWeb&category=research&rn=20&os=web&sv=7.7.5
# Tushare Pro（K线源 tushare，TUSHARE_TOKEN）
TUSHARE_BASE_URL=https://api.tushare.pro
# Anspire OpenAI 兼容网关（LLM 源 anspire，ANSPIRE_API_KEYS）
ANSPIRE_LLM_BASE_URL=https://open-gateway.anspire.cn/v6
ANSPIRE_LLM_MODEL=Doubao-Seed-2.0-lite
# 搜索型新闻源（NEWS_SOURCES 的 bocha/tavily/minimax）
BOCHA_SEARCH_URL=https://open.bochaai.com/v1/web-search
TAVILY_SEARCH_URL=https://api.tavily.com/search
MINIMAX_SEARCH_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
# Bocha API Keys（中文搜索优化，支持AI摘要，支持多个，逗号分隔）
# 获取: https://open.bocha.cn/
BOCHA_API_KEYS=
# MiniMax API Key（Coding Plan Web Search，支持多个，逗号分隔）
# 获取: https://platform.minimax.io/
MINIMAX_API_KEYS=
# Tavily API Keys（支持多个，逗号分隔）
TAVILY_API_KEYS=


# AIHubmix 聚合（https://aihubmix.com/?aff=CfMq）
# 一个 Key 用 GPT/Claude/Gemini/GLM/Qwen 等模型，无需科学上网
# AIHUBMIX_KEY=

# Anthropic Claude（https://console.anthropic.com）
# ANTHROPIC_API_KEY=

# OpenAI / 兼容 API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # 第三方 API 地址（中转站/代理），留空用官方

# 本地 ollama（LLM 源 ollama）
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5
# 本地 OpenAI 兼容端点（LLM 源 local，如 LM Studio）
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=local-model
# 命令行调本地模型（LLM 源 cli；支持 {prompt} 占位符，否则 stdin 传入）
LLM_CLI_CMD=ollama run qwen2.5

# ── [FULL] 可选: 记忆引擎 ────────────────────────────
# MEMORY_CAPACITY=10000
# 本地语义记忆嵌入模型 (bge-small-zh, 512维, 同NAS)；不设置会回退远程 HF 模型，离线/NAS 环境会失败
# LAAP_EMBEDDING_MODEL=/models/bge-small-zh

# ── [FULL] 可选: 日志 ────────────────────────────────
# LAAP_LOG_LEVEL=INFO
# 调试时改为 DEBUG
# LAAP_LOG_LEVEL=DEBUG

# ── [FULL] 可选: 小智 MCP ────────────────────────────
# XIAOZHI_MCP_TOKEN=

# ============================================
# 🔒 安全提醒
# ============================================
# .env 包含敏感 API 密钥，务必加入 .gitignore。
# 切勿提交到公开仓库！
# Docker 部署场景下，.env 不会被复制进镜像，
# 而是通过 docker compose 的 env_file 注入。
